        <item name="colorOnSecondaryContainer">@color/dark_md_theme_on_secondary_container</item>
        <item name="android:colorBackground">@color/dark_md_theme_background</item>
        <item name="colorOnBackground">@color/dark_md_theme_on_background</item>
        <item name="colorSurface">@color/dark_md_theme_surface</item>
